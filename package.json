{
  "name": "mlinzi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI payout agent for African SMEs on the XRP Ledger, within limits it can't override",
  "scripts": {
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "test:multisig": "tsx scripts/multisig-payment.ts",
